generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceType {
  transcript
  video
  post
  article
}

model Person {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  quotes      Quote[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Topic {
  id        String      @id @default(cuid())
  slug      String      @unique
  name      String
  quotes    QuoteTopic[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Source {
  id        String     @id @default(cuid())
  type      SourceType
  title     String
  url       String
  publisher String?
  quotes    Quote[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([url])
}

model Quote {
  id        String      @id @default(cuid())
  slug      String      @unique
  text      String
  date      DateTime
  context   String?

  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId String

  source   Source @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  sourceId String

  topics    QuoteTopic[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personId, date])
  @@index([date])
}

model QuoteTopic {
  quote   Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId String

  topic   Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  topicId String

  @@id([quoteId, topicId])
  @@index([topicId])
}

model MarketDaily {
  id     String   @id @default(cuid())
  symbol String
  date   DateTime
  close  Float

  provider String @default("stooq")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([symbol, date])
  @@index([symbol, date])
}
